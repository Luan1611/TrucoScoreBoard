<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:stretchColumns="*">
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <TextView
                android:text="@string/equipe_a"
                android:layout_column="0"
                android:textSize="40sp"/>
            <TextView
                android:text="@string/equipe_b"
                android:layout_column="1"
                android:textSize="40sp"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
        <TextView
            android:text="0"
            android:layout_column="0"
            android:textSize="80sp"/>
        <TextView
            android:text="0"
            android:layout_column="1"
            android:textSize="80sp"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <TextView
                android:text="@string/pontos"
                android:layout_column="0"
                android:textSize="40sp"/>
            <TextView
                android:text="@string/pontos"
                android:layout_column="1"
                android:textSize="40sp"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <Button
                android:id="@+id/equipeASomar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/_1_ponto"
                android:layout_column="0"/>

            <Button
                android:id="@+id/equipeBSomar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/_1_ponto"
                android:layout_column="1"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <Button
                android:id="@+id/equipeASomar3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/_3_pontos"
                android:layout_column="0"/>
            <Button
                android:id="@+id/equipeBSomar3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/_3_pontos"
                android:layout_column="1"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"            >
            <Button
                android:id="@+id/resetGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reiniciar_partida"
                android:layout_column="0"
                android:layout_span="2"/>
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>